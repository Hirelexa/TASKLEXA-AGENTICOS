# Tasklexa Agenticos local development settings.
# Copy to .env for local use. Do not commit real credentials.

ENVIRONMENT=local
DEMO_MODE=false
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

POSTGRES_DB=tasklexa
POSTGRES_USER=tasklexa
POSTGRES_PASSWORD=tasklexa_dev_password
DATABASE_URL=postgresql://tasklexa:tasklexa_dev_password@postgres:5432/tasklexa
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-side published port only (container-to-container traffic always uses 5432).
# Override if a native/other Postgres already occupies 5432 on this machine.
POSTGRES_HOST_PORT=5432

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tasklexa_dev_password
NEO4J_HOST=neo4j
NEO4J_BOLT_PORT=7687
# Host-side published ports only; override on conflict with an existing local Neo4j.
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687

REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
# Host-side published port only; override on conflict with an existing local Redis.
REDIS_HOST_PORT=6379

# External providers remain NOT_CONFIGURED until live credentials and tests exist.
OPENROUTER_API_KEY=
BAND_AGENT_ID=
BAND_API_KEY=
BAND_AGENT_KEY=
BAND_USER_KEY=
SIMILARWEB_API_KEY=
VULTR_API_KEY=

